// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}/src"],
			"sourceMaps": true,
			"outFiles": ["${workspaceFolder}/src/dist/**/*.js"],
			"preLaunchTask": "${defaultBuildTask}",
			"env": {
				"NODE_ENV": "development",
				"VSCODE_DEBUG_MODE": "true"
			},
			"resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
			"presentation": {
				"hidden": false,
				"group": "tasks",
				"order": 1
			}
		},
		{
			"name": "Zoo Queue V18",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}/src-queue-v18", "/home/markooo/V18"],
			"sourceMaps": true,
			"outFiles": ["${workspaceFolder}/src/dist/**/*.js"],
			"preLaunchTask": "${defaultBuildTask}",
			"env": {
				"NODE_ENV": "development",
				"VSCODE_DEBUG_MODE": "true",
				"ROO_CODE_IPC_SOCKET_PATH": "/tmp/zoo-queue-v18.sock",
				"ROO_CODE_SERVER_INSTANCE": "v18-queue-1",
				"ROO_CODE_BUILD_REVISION": "9bb6c0d44078fa4cb88ea28741fb7429188d3e2d"
			},
			"resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
			"presentation": {
				"hidden": false,
				"group": "tasks",
				"order": 1
			}
		},
		{
			"name": "Zoo Queue V18 Task 2",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/src-queue-v18-task2",
				"--folder-uri=vscode-remote://wsl+Ubuntu-20.04/home/markooo/V18_task2"
			],
			"sourceMaps": true,
			"outFiles": ["${workspaceFolder}/src/dist/**/*.js"],
			"preLaunchTask": "${defaultBuildTask}",
			"env": {
				"NODE_ENV": "development",
				"VSCODE_DEBUG_MODE": "true",
				"ROO_CODE_IPC_SOCKET_PATH": "/tmp/zoo-queue-v18_task2.sock",
				"ROO_CODE_SERVER_INSTANCE": "v18-queue-2",
				"ROO_CODE_BUILD_REVISION": "9bb6c0d44078fa4cb88ea28741fb7429188d3e2d"
			},
			"resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
			"presentation": {
				"hidden": false,
				"group": "tasks",
				"order": 2
			}
		},
		{
			"name": "Zoo Queue V19",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}/src-queue-v19", "/home/markooo/V19"],
			"sourceMaps": true,
			"outFiles": ["${workspaceFolder}/src/dist/**/*.js"],
			"preLaunchTask": "${defaultBuildTask}",
			"env": {
				"NODE_ENV": "development",
				"VSCODE_DEBUG_MODE": "true",
				"ROO_CODE_IPC_SOCKET_PATH": "/tmp/zoo-queue-v19.sock",
				"ROO_CODE_SERVER_INSTANCE": "v19-queue-1",
				"ROO_CODE_BUILD_REVISION": "9bb6c0d44078fa4cb88ea28741fb7429188d3e2d"
			},
			"resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
			"presentation": {
				"hidden": false,
				"group": "tasks",
				"order": 3
			}
		}
	]
}
